@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Xác Nhận Đơn Hàng - Adidas</title>
    @*<link href="~/Content/Header.css" rel="stylesheet" type="text/css" />*@
    <link href="~/Content/Oderconfirm.css" rel="stylesheet"  type="text/css"/>
</head>
<body>
    <!-- Header -->
    <div class="confirmation-header">
        <h1>XÁC NHẬN ĐƠN HÀNG</h1>
        <p>Cảm ơn bạn đã đặt hàng tại Adidas</p>
    </div>

    <!-- Main Content -->
    <div class="confirmation-container">
        <!-- Success Message -->
        <div class="success-badge">
            <h2>Đơn hàng của bạn đã được xác nhận!</h2>
            <p>Chúng tôi sẽ gửi chi tiết đơn hàng đến email của bạn trong vài phút</p>
        </div>

        <!-- Order Info -->
        <div class="order-info">
            <h3>THÔNG TIN ĐƠN HÀNG</h3>
            <div class="info-row">
                <span class="info-label">Mã đơn hàng:</span>
                <span class="info-value">#ADI-2025-001234</span>
            </div>
            <div class="info-row">
                <span class="info-label">Ngày đặt:</span>
                <span class="info-value">27/10/2025</span>
            </div>
            <div class="info-row">
                <span class="info-label">Trạng thái:</span>
                <span class="info-value" style="color: #4CAF50; font-weight: bold;">Đang xử lý</span>
            </div>
            <div class="info-row">
                <span class="info-label">Phương thức thanh toán:</span>
                <span class="info-value">Thẻ Visa</span>
            </div>
        </div>

        <!-- Order Items -->
        <div class="order-items">
            <h3>CHI TIẾT SẢN PHẨM</h3>

            <div class="item">
                <div class="item-details">
                    <div class="item-name">Giày Samba OG</div>
                    <div class="item-spec">Màu: Black / Lime | Kích cỡ: 42 | Số lượng: 1</div>
                </div>
                <div class="item-price">3.000.000₫</div>
            </div>

            @*<div class="item">
                <div class="item-details">
                    <div class="item-name">Bộ 3 Đôi Tất CLIMACOOL</div>
                    <div class="item-spec">Màu: Black | Kích cỡ: Free | Số lượng: 1</div>
                </div>
                <div class="item-price">3.000.000₫</div>
            </div>*@

            <div class="order-total">
                <span>Tổng cộng:</span>
                <span>3.000.000₫</span>
            </div>
        </div>

        <!-- Delivery Info -->
        <div class="delivery-info">
            <h3>THÔNG TIN GIAO HÀNG</h3>
            <div class="delivery-row">
                <strong>Người nhận:</strong> Nguyễn Văn A
            </div>
            <div class="delivery-row">
                <strong>Địa chỉ:</strong> 82/3 Đường Nguyễn Trí Phương, Quận 1, TP.HCM
            </div>
            <div class="delivery-row">
                <strong>Số điện thoại:</strong> 0912345678
            </div>
            <div class="delivery-row">
                <strong>Dự kiến giao:</strong> 30/10/2025 - 02/11/2025
            </div>
            <div class="delivery-row">
                <strong>Phí giao hàng:</strong> Miễn phí
            </div>
        </div>

        <!-- Actions -->
        <div class="confirmation-actions">
            @*<button class="btn btn-primary"  >TIẾP TỤC MUA SẮM</button>
            <button  class="btn btn-secondary">THEO DÕI ĐƠN HÀNG</button>*@
             <button class="btn btn-primary" onclick="continueShopping()">TIẾP TỤC MUA SẮM</button>

             <a href="~/Oder/Odertracking"><button class="btn btn-secondary" onclick="trackOrder()">THEO DÕI ĐƠN HÀNG</button></a>
</div>
       
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-container">
            <div class="footer-top">
                <div class="footer-top-right">
                    <p>
                        Questions? +84 28 44581037|
                        Thứ Hai đến Thứ Bảy (ngoại trừ Chủ Nhật, ngày Giáng Sinh và ngày Tết Dương Lịch): Từ 9 giờ sáng đến 9 giờ tối.
                    </p>

                </div>
            </div>

            <div class="footer-bottom">
                <a href="#">Cài Đặt Cookie</a>
                <span>|</span>
                <a href="#">Chính sách Bảo mật</a>
                <span>|</span>
                <a href="#">Các Điều Khoản và Điều Kiện</a>
                <span>|</span>
                <a href="#">Thông tin công ty</a>
            </div>

            <div class="footer-copyright">
                © 2025·adidas Vietnam Company Limited
            </div>
        </div>
    </footer>

    <script src="~/Scripts/Oderconfirm.js"></script>
</body>
</html>