@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Oder Tracking</title>
    <link href="~/Content/Header.css" rel="stylesheet"  type="text/css"/>
    <link href="~/Content/Odertracking.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <header>
        <section>
            <nav class="sub-nav" role="navigation" aria-label="Sub navigation">
                <ul class="sub-nav__list">
                    <li><a href="#" class="sub-nav__link">TRANG CHỦ</a></li>
                    <li><a href="#" class="sub-nav__link sub-nav__link--active">ĐƠN HÀNG</a></li>
                    @*<a href="~/Views/Oder/Oder.cshtml">~/Views/Oder/Oder.cshtml</a>*@
                    <li><a href="~/Oder/Oder" class="sub-nav__link">GIỎ HÀNG</a></li>
                </ul>
            </nav>
        </section>
    </header>
    <main class="order-tracking-page">
        <h1>ĐƠN HÀNG</h1>

        <!-- Tab -->
        <nav class="tabs" role="tablist" aria-label="Shop tabs">
            <button class="tab active" role="tab" aria-selected="true">Online</button>
            <button class="tab" role="tab" aria-selected="false">In-store</button>
        </nav>

        <div class="order-filter">
            <label for="order-time" class="order-filter__label">View orders from:</label>
            <select id="order-time" class="order-filter__select">
                <option value="Any time">Any time</option>
                <option value="This month">This month</option>
                <option value="Last 30 days">Last 30 days</option>
                <option value="Last 6 months">Last 6 months</option>
                <option value="2025">2025</option>
            </select>
        </div>

        <!-- Orders Container -->
        <div class="orders-container show">
            <!-- Đơn hàng 1 - Đang giao -->
            <div class="order-item">
                <div class="order-header">
                    <span class="order-id">Đơn hàng #ADI-2025-001</span>
                    <span class="order-status shipping">Đang giao hàng</span>
                </div>
                <div class="order-date">Ngày đặt: 18/10/2025</div>
                <div class="order-details">
                    <p><strong>Sản phẩm:</strong> Giày Samba OG x1, Bộ tất CLIMACOOL x1</p>
                    <p><strong>Tổng tiền:</strong> 6.000.000₫</p>
                    <p><strong>Địa chỉ giao:</strong> 82/3 Đường Nguyễn Tri Phương, Quận 1, TP.HCM</p>
                    <p><strong>Dự kiến giao:</strong> 28/10/2025</p>
                </div>
            </div>
        </div>

        <!-- Empty Orders (ẩn khi có đơn hàng) -->
        <div class="empty-orders">
            <h2>CHƯA CÓ ĐƠN HÀNG NÀO</h2>
            <p>Bạn đã sẵn sàng để bắt đầu chưa?</p>
        </div>

        <div class="shopping-cta">
            <a href="#">
                <button>
                    <p>BẮT ĐẦU MUA SẮM→</p>
                </button>
            </a>
        </div>

        <div class="oder-help">
            <p>Bạn đang tìm kiếm đơn hàng được đặt từ tài khoản khác?</p>
            <a href="#">Kiểm tra trạng thái đơn hàng của bạn</a>
        </div>

        <!-- FAQ Section -->
        <section id="faq" class="faq-section">
            <h2 class="faq-heading">CÂU HỎI THƯỜNG GẶP</h2>
            <div class="faq-grid">
                <!-- Câu hỏi 1 -->
                <div class="faq-item">
                    <h3 class="faq-question">LÀM CÁCH NÀO TÔI CÓ THỂ TRẢ HÀNG?</h3>
                    <p class="faq-answer">Trả Lại Hàng & Hoàn Tiền</p>
                </div>

                <!-- Câu hỏi 2 -->
                <div class="faq-item">
                    <h3 class="faq-question">Khi nào tôi sẽ được hoàn tiền?</h3>
                    <p class="faq-answer">Trả Lại Hàng & Hoàn Tiền</p>
                </div>

                <!-- Câu hỏi 3 -->
                <div class="faq-item">
                    <h3 class="faq-question">Tại sao đơn hàng trực tuyến của tôi bị hủy?</h3>
                    <p class="faq-answer">Đang đặt hàng</p>
                </div>

                <!-- Câu hỏi 4 -->
                <div class="faq-item">
                    <h3 class="faq-question">Thời gian giao hàng là khi nào?</h3>
                    <p class="faq-answer">GIAO HÀNG</p>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="footer-container">
            <div class="footer-top">
                <div class="footer-top-right">
                    <p>
                        Questions? +84 28 44581037|
                        Thứ Hai đến Thứ Bảy (ngoại trừ Chủ Nhật, ngày Giáng Sinh và ngày Tết Dương Lịch): Từ 9 giờ sáng đến 9 giờ tối.
                    </p>

                </div>
            </div>

            <div class="footer-bottom">
                <a href="#">Cài Đặt Cookie</a>
                <span>|</span>
                <a href="#">Chính sách Bảo mật</a>
                <span>|</span>
                <a href="#">Các Điều Khoản và Điều Kiện</a>
                <span>|</span>
                <a href="#">Thông tin công ty</a>
            </div>

            <div class="footer-copyright">
                © 2025·adidas Vietnam Company Limited
            </div>
        </div>
    </footer>
    <script src="~/Scripts/Header.js"></script>
    <script src="~/Scripts/Odertracking.js"></script>
</body>
</html>