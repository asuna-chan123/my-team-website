@{
    ViewBag.Title = "Đăng nhập hoặc Đăng ký | Adidas Store";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/css/login.css" />
    <link rel="stylesheet" href="~/Content/partials/header.css" />
    <link rel="stylesheet" href="~/Content/partials/footer.css" />
}
<section class="login-container">
    <main class="login-container">
        <div class="login-box">
            <!-- Logo + tiêu đề -->
            <div class="login-header">
                <div class="brand">
                    <img src="~/Content/partials/iconheader/adidas-black-logo.png" alt="Adidas" class="brand-logo" />
                    <span class="brand-text">adiclub</span>
                </div>
                <h2>ĐĂNG NHẬP HOẶC ĐĂNG KÝ</h2>
                <p>
                    Tận hưởng quyền truy cập chỉ dành cho hội viên vào các sản phẩm,
                    trải nghiệm, ưu đãi độc quyền và hơn thế nữa.
                </p>
            </div>

            <!-- Nút mạng xã hội -->
            <div class="social-login">
                <button class="social-btn apple" onclick="window.open('https://account.apple.com/', '_blank')">
                    <img src="~/Content/css/assets/images/applelogo.jpg" alt="Apple" />
                    <span>TIẾP TỤC VỚI APPLE</span>
                </button>

                <button class="social-btn facebook" onclick="window.open('https://www.facebook.com/login', '_blank')">
                    <img src="~/Content/css/assets/images/Facebook.png" alt="Facebook" />
                    <span>TIẾP TỤC VỚI FACEBOOK</span>
                </button>

                <button class="social-btn google" onclick="window.open('https://accounts.google.com/', '_blank')">
                    <img src="~/Content/css/assets/images/Google__G__logo.svg.png" alt="Google" />
                    <span>TIẾP TỤC VỚI GOOGLE</span>
                </button>
            </div>

            <!-- Form -->
            <form method="post" action="#">
                <input type="email" placeholder="ĐỊA CHỈ EMAIL *" required />

                <label>
                    <input type="checkbox" required /> Có, tôi trên 16 tuổi
                    <a href="#">Tại sao nó quan trọng?</a>
                </label>

                <label>
                    <input type="checkbox" required />
                    Tôi đã đọc, hiểu và chấp thuận
                    <a href="#">Chính sách Bảo mật của adidas</a>,
                    <a href="#">Các Điều khoản và Điều kiện của adiClub</a>.
                </label>

                <label>
                    <input type="checkbox" />
                    Tôi đồng ý việc sử dụng thông tin cá nhân cho mục đích quảng cáo
                    (<a href="#">Chi tiết tại Chính sách bảo mật</a>).
                </label>

                <label>
                    <input type="checkbox" />
                    Tôi đồng ý việc chia sẻ, sử dụng dữ liệu theo
                    <a href="#">chính sách bảo mật</a>.
                </label>

                <label class="remember">
                    <input type="checkbox" checked /> Giữ đăng nhập cho tôi.
                    <a href="#">Thêm thông tin</a>
                </label>

                <button action="../Products/ProductList" type="submit" class="submit-btn">TIẾP TỤC →</button>
            </form>
        </div>
    </main>
</section>

@section Scripts {
    <script src="~/Scripts/includePartials.js" defer></script>
}
