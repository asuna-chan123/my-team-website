@model WebApplication6.ViewModels.LoginVM
@{
    ViewBag.Title = "Đăng nhập | Adidas Store";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- CSS riêng của trang -->
<link href="/Content/css/login.css" rel="stylesheet" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-top:15px;">
        @TempData["Success"]
    </div>
}

<div class="login-page">
    <div class="login-page-wrapper">

        <!-- LEFT CONTENT -->
        <div class="left-info">
            <img src="~/Content/images/adiclub-banner.jpeg" class="left-img" />
            <h1>THAM GIA ADICLUB<br />ĐỂ NHẬN NHIỀU ƯU ĐÃI HƠN</h1>

            <ul class="benefits">
                <li>Voucher chào mừng 10% OFF</li>
                <li>Miễn phí giao hàng</li>
                <li>Sản phẩm dành riêng cho thành viên</li>
                <li>Ưu tiên truy cập giảm giá</li>
                <li>Tham gia các phiên bản giới hạn</li>
            </ul>

            <p class="desc">
                Tích điểm adiClub mỗi khi bạn mua sắm hoặc đánh giá sản phẩm để nâng cấp
                thành viên và nhận thêm nhiều phần thưởng hấp dẫn.
            </p>
        </div>

        <!-- RIGHT BOX -->
        <div class="login-box">

            <!-- HEADER -->
            <div class="login-header">
                <div class="brand">
                    <img src="~/Content/partials/iconheader/adidas-black-logo.png" class="brand-logo" />
                    <span class="brand-text">adiclub</span>
                </div>

                <h2>ĐĂNG NHẬP</h2>
                <p>
                    Tận hưởng quyền truy cập dành riêng cho thành viên vào các sản phẩm,
                    trải nghiệm, ưu đãi độc quyền và nhiều hơn thế nữa.
                </p>
            </div>

            <!-- SOCIAL BUTTONS -->
            <div class="social-row">
                <a href="https://account.apple.com/" class="social-small apple">
                    <img src="~/Content/css/assets/images/applelogo.jpg" alt="Apple Login" />
                </a>

                <a href="https://www.facebook.com/login/" class="social-small facebook">
                    <img src="~/Content/css/assets/images/Facebook.png" alt="Facebook Login" />
                </a>

                <a href="https://accounts.google.com/v3/signin/identifier?continue=https%3A%2F%2Faccounts.google.com%2F&dsh=S1882428851%3A1764041231893323&followup=https%3A%2F%2Faccounts.google.com%2F&ifkv=ARESoU1Kvci7jT8gFB7-YLeTx61VQvL8QG2RaTUZykL_en-2OJlmoY8Yn3mPANzD4mAUNcm8rpmu5Q&passive=1209600&flowName=GlifWebSignIn&flowEntry=ServiceLogin" 
                   class="social-small google">
                    <img src="~/Content/css/assets/images/Google__G__logo.svg.png" alt="Google Login" />
                </a>
            </div>

            <!-- FORM LOGIN MVC -->
            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div style="margin-top:1%; border:1px;">
                    <input type="text"
                           name="Username"
                           placeholder="TÊN ĐĂNG NHẬP HOẶC EMAIL *"
                           required />
                </div>
                <div style="margin-top:1%; border:1px;">
                    <input type="password"
                           name="Password"
                           placeholder="MẬT KHẨU *"
                           required />
                </div>



                <label class="check remember">
                    <input type="checkbox" checked />
                    Giữ tôi đăng nhập. Áp dụng cho tất cả các tùy chọn.
                </label>

                <button type="submit" class="submit-btn">TIẾP TỤC →</button>
            }

            <p class="login-redirect">
                Chưa có tài khoản? <a href="/Account/Register">Đăng ký</a>
            </p>
        </div>
    </div>
</div>
<script>
  if (window.location.pathname === "/") {
    const link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = "trangchu.css";
    document.head.appendChild(link);
  }
</script>
