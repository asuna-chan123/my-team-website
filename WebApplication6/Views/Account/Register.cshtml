@model WebApplication6.ViewModels.RegisterVM
@{
    ViewBag.Title = "Đăng ký thành viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/register.css" />

<div class="register-wrapper">

    <div class="register-box">
        <h2>ĐĂNG KÝ THÀNH VIÊN</h2>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            @Html.TextBoxFor(m => m.FullName, new { placeholder = "Họ và tên *" })
            @Html.TextBoxFor(m => m.Email, new { placeholder = "Email *", type = "email" })
            @Html.TextBoxFor(m => m.Username, new { placeholder = "Tên đăng nhập *" })
            @Html.PasswordFor(m => m.Password, new { placeholder = "Mật khẩu *" })
            @Html.PasswordFor(m => m.ConfirmPassword, new { placeholder = "Xác nhận mật khẩu *" })
            @Html.TextBoxFor(m => m.Phone, new { placeholder = "Số điện thoại" })

            <button type="submit" class="submit-btn">TẠO TÀI KHOẢN →</button>
        }

        <p class="login-redirect">Đã có tài khoản? <a href="/Account/Login">Đăng nhập</a></p>
    </div>
</div>
