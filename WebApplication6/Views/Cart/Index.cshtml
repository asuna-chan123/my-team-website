@model WebApplication6.ViewModels.CartViewModels.Cart
@{
    ViewBag.Title = "Cửa hàng Adidas trực tuyến | Adidas VN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/Cart/Cart.css" rel="stylesheet" type="text/css" />

<div class="container cart-page-container">
    <div class="row">
        <div class="col-md-8">
            @*Khối tổng quan giỏ hàng*@
            <div class="cart-overview mt-5 mb-4">
                <h2 class="font-weight-bold text-uppercase mb-4 giohang" style="letter-spacing: 1.5px; font-size: 2rem; ">GIỎ HÀNG CỦA BẠN</h2>

                @if (Model != null && Model.Items != null && Model.Items.Any())
                {
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-uppercase fw-bold" style="font-size: 1.1rem; letter-spacing: 0.5px;">TỔNG CỘNG (@Model.Items.Count() sản phẩm)</span>
                        <span class="fw-bold" style="font-size: 1.1rem;">@Model.TotalValue().ToString("N0")đ</span>
                    </div>

                    <div class="text-muted" style="font-size: 0.95rem;">
                        Các mặt hàng trong giỏ hàng của bạn không được bảo lưu — hãy kiểm tra ngay để đặt hàng.
                    </div>
                    
                }
            </div>

            @if (Model == null || Model.Items == null || !Model.Items.Any())
            {
                <div><p class="text-start">Bạn chưa có sản phẩm nào trong giỏ.</p></div>
                @Html.ActionLink("GET STARTED⭢ ", "ProductList", "Products", null, new { @class = "btn btn-dark button-back" })
            }
            else

            {
        <div class="sale mb-4 col-md-12" style="background: #E9ECEF; padding: 20px 30px; border-radius: 0px;">
            <p style="font-weight: bold; font-size: 1.1rem; margin-bottom: 10px; text-align: left; color: #000000;">BLACK FRIDAY SALE!</p>
            <p style="text-align: justify; margin-bottom: 0; line-height: 1.6; color: #000000;">
                Mua sản phẩm adidas yêu thích với ưu đãi giảm giá lên đến 60% từ 25
                tháng 11 đến 02 tháng 12 năm 2025. Nhận thêm 15% giảm giá khi
                thanh toán tại giỏ hàng. Điều khoản và điều kiện áp dụng.                
                    <a href="@Url.Action("ProductList", "Products")" class="btn btn-link text-dark text-decoration-none ">Mua Sắm ngay>></a>                
            </p>
            
        </div>
                foreach (var item in Model.Items)
                {


                    <div class="cart-item row mb-3 p-3">
                        <div class="col-md-3 cart-image">
                            @*<img src="@item.ImagePro" alt="@item.NamePro" title="@item.NamePro" class="img-fluid" style="max-height:150px;" />*@
                            <img src="@item.ImagePro" class="card-img-top" alt="@item.NamePro" style="max-width:200px; object-fit: cover;">
                        </div>

                        <div class="col-md-7 cart-details">
                            <div class="row">
                                <div class="col-md-9 items-details">
                                    <h5>@item.NamePro</h5>
                                    <div class="product-specs">
                                        @if (!string.IsNullOrEmpty(item.Color))
                                        {
                                            <p class="mb-1">Màu sắc: @item.Color</p>
                                        }
                                        @if (!string.IsNullOrEmpty(item.Size))
                                        {
                                            <p class="mb-1">Kích cỡ: @item.Size</p>
                                        }
                                    </div>
                                    <b>Mặc hàng có sẵn mới nhất</b>
                                    <p>Đơn giá: @item.UnitPrice.ToString("N0")₫</p>
                                    @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post))
                                    {
                                        <input type="hidden" name="id" value="@item.ProductID" />
                                        <select name="quantity"
                                                class="form-control"
                                                onchange="this.form.submit()"
                                                style="width: 80px; border:1px solid #000000;border-radius:0px; ">
                                            @for (int i = 1; i <= Math.Min(item.StockQty, 10); i++)
                                            {
                                                <option value="@i" @(i == item.Quantity ? "selected" : "")>@i</option>
                                            }
                                        </select>
                                    }
                                    <small class="text-muted">Còn @item.StockQty sản phẩm trong kho</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-2 cart-button text-center">
                            <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                Xóa
                            </a>
                        </div>
                    </div>
                }
            }
        </div>

        @if (Model != null && Model.Items != null && Model.Items.Any())
        {
            <div class="col-md-4 cart-summary mt-3 mb-5">
                <div class="total-sumary">
                    <div class="cart-title">
                        <h6>TÓM TẮT ĐƠN HÀNG</h6>
                    </div>
                    <div>
                        <div class="cart-total">
                            <span>@Model.Items.Sum(x => x.Quantity) sản phẩm</span>
                            <span class="item-price">@Model.TotalValue().ToString("N0")₫</span>
                        </div>
                        <div class="cart-total">
                            <span class="shipping-label">Giao hàng</span>
                            <span class="shipping-price">Miễn phí</span>
                        </div>

                        <div class="cart-row total">
                            <span class="total-label">Tổng</span>
                            <span class="total-price">@Model.TotalValue().ToString("N0")₫</span>
                        </div>
                        <p class="text-muted small mt-1">(Đã bao gồm thuế VAT)</p>
                    </div>

                    @if (Model.Items.Any())
                    {
                        <div class="promo-code-container">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M2 9V6.5C2 5.67157 2.67157 5 3.5 5H20.5C21.3284 5 22 5.67157 22 6.5V9C22 9.55228
                              21.5523 10 21 10C20.4477 10 20 10.4477 20 11V13C20 13.5523 20.4477 14 21 14C21.5523 14 22 14.4477
                              22 15V17.5C22 18.3284 21.3284 19 20.5 19H3.5C2.67157 19 2 18.3284 2 17.5V15C2 14.4477 2.44772 14 3
                              14C3.55228 14 4 13.5523 4 13V11C4 10.4477 3.55228 10 3 10C2.44772 10 2 9.55228 2 9ZM4 9.53553V7H20V9.53553C19.4142
                              9.82843 19 10.4142 19 11V13C19 13.5858 19.4142 14.1716 20 14.4645V17H4V14.4645C4.58579 14.1716 5 13.5858 5 13V11C5
                              10.4142 4.58579 9.82843 4 9.53553ZM7 11H17V13H7V11Z" fill="black" />
                            </svg>
                            <a href="@Url.Action("PromoCode", "Cart")" class="promo-code-text">SỬ DỤNG MÃ KHUYẾN MÃI</a>
                        </div>

                        <div class="mb-3">
                            <a href="@Url.Action("Checkout", "order")" class="btn-checkout">
                                <span>THANH TOÁN</span>
                            </a>
                        </div>
                    }

                    <div class="payment-methods">
                        <div class="payment-title">PHƯƠNG THỨC THANH TOÁN ĐƯỢC CHẤP NHẬN</div>
                        <div class="payment-icons">
                            <img src="~/Content/Resources/Mastercard-removebg-preview.png" alt="Mastercard" />
                            <img src="~/Content/Resources/Visa-Logo.png" alt="Visa" />
                            <img src="~/Content/Resources/Money.jpg" alt="Cash" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@*gợi ý sản phẩm*@
@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <div class="container mt-5 mb-5 ">
        <div class="px-5">
            <h5 class="mb-4 font-weight-bold">GỢI Ý CHO BẠN</h5>
        </div>
        <div class="row">
            <div class=" col-md-7 d-flex flex-row flex-nowrap overflow-auto gap-3 pb-3 ps-5 featured-scroll-container ">
                @foreach (var item in Model.FeaturedProducts)
                {
                    <div class="flex-shrink-0">
                        <div class="card border-0 position-relative" style="width: 240px;">
                            <a href="@Url.Action("Details", "Products", new { id = item.ProductID })">
                                <img src="@item.ImagePro"
                                     class="card-img-top"
                                     alt="@item.NamePro"
                                     style="height: 240px; object-fit: cover; border-radius: 8px;">
                            </a>
                            <div class="card-body px-0 py-2">
                                <h6 class="mb-1 font-weight-bold" style="font-size: 0.95rem;">
                                    @item.Price.GetValueOrDefault().ToString("N0")đ
                                </h6>
                                <p class="text-danger mb-1" style="font-size: 0.8rem;">Giảm giá -20%</p>
                                <p class="text-dark mb-1" style="font-size: 0.85rem; line-height: 1.3;">
                                    @item.NamePro
                                </p>
                                <p class="text-muted mb-0" style="font-size: 0.75rem;">@(item.Category?.NameCate ?? "Giày thể thao")</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}