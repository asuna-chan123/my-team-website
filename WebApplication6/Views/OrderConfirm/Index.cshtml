@model WebApplication6.Models.OrderPro
@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Calculate total
    double totalAmount = 0;
    if (Model != null && Model.OrderDetails != null)
    {
        totalAmount = Model.OrderDetails.Sum(d => (d.Quantity ?? 0) * (d.UnitPrice ?? 0));
    }
}
https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css
<style>
    https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css
    .order-confirm-icon {
        width: 64px;
        height: 64px;
        background-color: black;
        color: white;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 24px;
    }

    .order-details-box {
        border: 2px solid black; /* Yêu cầu: Đường kẻ đen */
        border-radius: 8px;
        padding: 32px;
        margin-bottom: 32px;
        background-color: white;
    }

    .order-label {
        font-size: 12px;
        color: #6c757d;
        font-weight: bold;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .order-value {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 0;
    }

    .product-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 4px;
        background-color: #f8f9fa;
    }

    .btn-adidas {
        background-color: #000;
        color: #fff !important;
        padding: 18px 20px;
        text-transform: uppercase;
        font-weight: 700;
        display: flex;
        justify-content: center;
        align-items: center;
        border: none;
        letter-spacing: 2px;
        position: relative;
        text-decoration: none;
        transition: all 0.3s;
        width: 100%;
    }

        .btn-adidas:hover {
            color: #fff;
            opacity: 0.8;
            text-decoration: none;
        }
</style>

<div class="container" style="margin-top: 100px; margin-bottom: 100px;">
    @if (Model == null)
    {
        <div class="text-center">
            <h2 class="text-danger font-weight-bold">Không tìm thấy đơn hàng!</h2>
            <a href="@Url.Action("ProductList", "ProductsController")" class="btn btn-link mt-3">Về trang chủ</a>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-8">
                <!-- Header -->
                <div class="text-center mb-5">                    
                    <h1 class="font-weight-bold text-uppercase mb-3">ĐẶT HÀNG THÀNH CÔNG</h1>
                    <p class="text-muted" style="font-size: 18px;">Thank you for your purchase. Your order #@Model.ID has been confirmed.</p>
                </div>

                <!-- Order Details Box -->
                <div class="order-details-box  "style="border-radius:0px;">
                    <h5 class="font-weight-bold text-uppercase mb-4" style="letter-spacing: 1px;">ORDER DETAILS</h5>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-4">
                            <p class="order-label">ORDER NUMBER</p>
                            <p class="order-value">@Model.ID</p>
                        </div>
                        <div class="col-md-6 mb-4">
                            <p class="order-label">ORDER DATE</p>
                            <p class="order-value">@(Model.DateOrder.HasValue ? Model.DateOrder.Value.ToString("MMM dd, yyyy") : "N/A")</p>
                        </div>
                        <div class="col-md-6 mb-4">
                            <p class="order-label">ESTIMATED DELIVERY</p>
                            <p class="order-value">
                                @(Model.DateOrder.HasValue ? Model.DateOrder.Value.AddDays(3).ToString("MMM dd") + " - " + Model.DateOrder.Value.AddDays(5).ToString("MMM dd, yyyy") : "N/A")
                            </p>
                        </div>
                        <div class="col-md-6 mb-4">
                            <p class="order-label">TOTAL AMOUNT</p>
                            <p class="order-value">@String.Format("{0:N0}₫", totalAmount)</p>
                        </div>
                    </div>

                    <div class="border-top pt-4">
                        <h6 class="order-label mb-4">ITEMS ORDERED</h6>

                        @foreach (var detail in Model.OrderDetails)
                        {
                            <div class="media mb-4">
                                <div class="mr-3">
                                    @if (detail.Product != null)
                                    {
                                        <img src="@Url.Content("~/Content/images/" + (detail.Product.ImagePro ?? "no-image.png"))"
                                             alt="@detail.Product.NamePro"
                                             class="product-img border" />
                                    }
                                </div>
                                <div class="media-body">
                                    <h6 class="mt-0 font-weight-bold text-uppercase">@(detail.Product != null ? detail.Product.NamePro : "Product")</h6>
                                    <div class="text-muted small">
                                        Qty: @detail.Quantity
                                    </div>
                                    <div class="font-weight-bold mt-1">
                                        @String.Format("{0:N0}₫", detail.UnitPrice)
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Buttons -->
                <div class="text-center">
                    <div class="row justify-content-center">
                        <div class="col-md-5 mb-3">
                            <a href="@Url.Action("Index", "Products")" class="btn-adidas">
                                CONTINUE SHOPPING
                            </a>
                        </div>
                        <div class="col-md-5 mb-3">
                            <a href="@Url.Action("ProductList", "Products")" class="btn-adidas">
                                VỀ TRANG CHỦ
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
