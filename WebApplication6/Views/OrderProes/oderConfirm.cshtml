﻿

@{
    ViewBag.Title = "Cửa hàng Adidas trực tuyến | Adidas VN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Xác Nhận Đơn Hàng - Adidas</title>
   

    <link href="~/Content/oderProes/oderConfirm.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Header -->
    <div class="confirmation-header">
        <h1>XÁC NHẬN ĐƠN HÀNG</h1>
        <p>Cảm ơn bạn đã đặt hàng tại Adidas</p>
    </div>


    <div class="confirmation-container">

        <div class="success-badge">
            <h2>Đơn hàng của bạn đã được xác nhận!</h2>
            <p>Chúng tôi sẽ gửi chi tiết đơn hàng đến email của bạn trong vài phút</p>
        </div>

        <!-- thông tin đơn hàng-->
        <div class="order-info">
            <h3>THÔNG TIN ĐƠN HÀNG</h3>
            <div class="info-row">
                <span class="info-label">Mã đơn hàng:</span>
                <span class="info-value">#ADI-2025-001234</span>
            </div>
            <div class="info-row">
                <span class="info-label">Ngày đặt:</span>
                <span class="info-value">27/10/2025</span>
            </div>
            <div class="info-row">
                <span class="info-label">Trạng thái:</span>
                <span class="info-value" style="color: #4CAF50; font-weight: bold;">Đang xử lý</span>
            </div>
            <div class="info-row">
                <span class="info-label">Phương thức thanh toán:</span>
                <span class="info-value">Thẻ Visa</span>
            </div>
        </div>

        <!-- Order Items -->
        <div class="order-items">
            <h3>CHI TIẾT SẢN PHẨM</h3>

            <div class="item">
                <div class="item-details">
                    <div class="item-name">Giày Samba OG</div>
                    <div class="item-spec">Màu: Black / Lime | Kích cỡ: 42 | Số lượng: 1</div>
                </div>
                <div class="item-price">3.000.000₫</div>
            </div>
            <div class="order-total">
                <span>Tổng cộng:</span>
                <span>3.000.000₫</span>
            </div>
        </div>

        <!-- thông tin giao hàng -->
        <div class="delivery-info">
            <h3>THÔNG TIN GIAO HÀNG</h3>
            <div class="delivery-row">
                <strong>Người nhận:</strong> Nguyễn Văn A
            </div>
            <div class="delivery-row">
                <strong>Địa chỉ:</strong> 82/3 Đường Nguyễn Trí Phương, Quận 1, TP.HCM
            </div>
            <div class="delivery-row">
                <strong>Số điện thoại:</strong> 0912345678
            </div>
            <div class="delivery-row">
                <strong>Dự kiến giao:</strong> 30/10/2025 - 02/11/2025
            </div>
            <div class="delivery-row">
                <strong>Phí giao hàng:</strong> Miễn phí
            </div>
        </div>

        <!-- button -->
        <div class="confirmation-actions">
            <button class="btn btn-primary" onclick="continueShopping()">TIẾP TỤC MUA SẮM</button>
            <a href="~/OrderProes/oderTracking"<button class="btn btn-secondary" onclick="trackOrder()">THEO DÕI ĐƠN HÀNG</button></a>

        </div>

    </div>
    <script>
        function continueShopping() {
            alert('Chuyển đến Trang chủ')
            window.location.href = '/Products/ProductList';
        }
        function trackOrder() {
            alert('Đơn hàng đang vận chuyển')
            window.location.href = '/OrderProes/oderTracking';
        }
    </script>


    
</body>
</html>
