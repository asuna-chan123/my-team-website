@model WebApplication6.ViewModels.ShippingOrderViewModel
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <style>
        .btn-adidas {
            background-color: #000;
            color: #fff !important;
            padding: 10px 20px;
            text-transform: uppercase;
            font-weight: 700;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            border: none;
            letter-spacing: 1px;
            position: relative;
            text-decoration: none;
            transition: all 0.3s;
            font-size: 14px;
        }
            .btn-adidas:hover {
                color: #fff;
                opacity: 0.8;
                text-decoration: none;
            }
    </style>
</head>
<div class="container" style="margin-top: 100px; margin-bottom: 50px;">
    <div class="mb-3">
        <a href="@Url.Action("Index", "OrderTracking")" class="btn-adidas">
            &larr; Quay lại danh sách
        </a>
    </div>

    <div class="card">
        <div class="card-header  text-white" style="border-radius:0px;background-color:#000">
            <h4 class="mb-0">Đơn hàng #@Model.OrderID</h4>
            <small>Ngày đặt: @(Model.OrderDate.HasValue ? Model.OrderDate.Value.ToString("dd/MM/yyyy") : "N/A")</small>
        </div>
        <div class="card-body"style=" border:1px solid #000;border-radius:0px;">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h6>Thông tin người nhận</h6>
                    <p>
                        <strong>Họ tên:</strong> @Model.CustomerName<br />
                        <strong>Số điện thoại:</strong> @Model.CustomerPhone<br />
                        <strong>Địa chỉ:</strong> @Model.ShippingAddress
                    </p>
                </div>
                <div class="col-md-6 text-end">
                    <div><b style="color:black;font-size:25px;">Tổng cộng</b></div>
                    <b style="color:red;font-size:20px;"> @Model.TotalAmount.ToString("N0")₫</b>
                </div>
            </div>
            <h5>Chi tiết sản phẩm</h5>
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width: 100px;">Ảnh</th>
                        <th>Sản phẩm</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <img src="~/Content/images/@item.ProductImage" alt="@item.ProductName" class="img-fluid" style="max-height: 80px;" />
                            </td>
                            <td>@item.ProductName</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.Price.ToString("N0")₫</td>
                            <td class="text-end fw-bold">@item.TotalPrice.ToString("N0")₫</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
