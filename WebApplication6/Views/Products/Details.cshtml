@model WebApplication6.Models.Product
@using System.Collections.Generic
@using System.Linq

@{
    ViewBag.Title = Model.NamePro;

    // Lấy tên danh mục
    var categoryName =
        Model.Category != null ? Model.Category.NameCate : "";

    // Hiển thị giới tính
    string genderDisplay =
        Model.Gender == "Nam" ? "Nam" :
        Model.Gender == "Nữ" ? "Nữ" :
        Model.Gender == "Unisex" ? "Unisex" :
        "Khác";

    // Lấy danh sách ảnh theo màu
    var imagesByColor =
        ViewBag.ImagesByColor as Dictionary<int, List<string>>
        ?? new Dictionary<int, List<string>>();

    // Màu mặc định
    int defaultColor = 0;
    if (ViewBag.DefaultColor != null)
    {
        defaultColor = (int)ViewBag.DefaultColor;
    }

    else if (imagesByColor.Keys.Any())
    {
        defaultColor = imagesByColor.Keys.First();
    }


    // Lấy ảnh đầu tiên làm ảnh chính
    string GetImagePath(string file)
    {
        if (string.IsNullOrEmpty(file))
            return Url.Content("~/Content/images/no-image.png");

        if (file.StartsWith("http", System.StringComparison.OrdinalIgnoreCase))
            return file;

        return Url.Content("~/Content/images/" + file);
    }

    string mainImage = imagesByColor.ContainsKey(defaultColor)
        ? GetImagePath(imagesByColor[defaultColor].FirstOrDefault())
        : Url.Content("~/Content/images/no-image.png");

    var colorNames = ViewBag.ColorNames as Dictionary<int, string>
                 ?? new Dictionary<int, string>();
}

<!DOCTYPE html>
<html lang="vi">

    <!--Chi tiết sản phẩm-->
    <!--CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/css/Product-detail-Tshirt.css")" />
    <link rel="stylesheet" href="~/Content/css/fonts-reset.css">

<style>
    .disabled-btn {
        background-color: #ccc !important;
        cursor: not-allowed !important;
        opacity: 0.7;
    }

        .disabled-btn span {
            opacity: 0.6;
        }

    .qty-btn-disabled {
        opacity: 0.4;
        cursor: not-allowed !important;
        pointer-events: none; /* không thể click */
    }

</style>


<div class="container" style="margin-top:5%;">
    <nav class="breadcrumb">
        <a href="@Url.Action("ProductList","Product")">Trang chủ</a>
        <span class="sep">/</span>

        <a href="@Url.Action("Index","Products", new { gender = Model.Gender })">
            @genderDisplay
        </a>
        <span class="sep">/</span>

        <a href="@Url.Action("Index","Products", new { category = categoryName })">
            @categoryName
        </a>
        <span class="sep">/</span>

        <span>@Model.NamePro</span>
    </nav>



    <div class="product-section">
        <div class="image-gallery">


            <!-- ẢNH CHÍNH -->
            <div class="main-image">
                @{
                    // lấy ảnh đầu tiên của màu mặc định
                    var firstImage = imagesByColor.ContainsKey(defaultColor)
                        ? imagesByColor[defaultColor].FirstOrDefault()
                        : Url.Content("~/Content/images/no-image.png");
                }
                <img id="mainImage"
                     src="@firstImage"
                     alt="@Model.NamePro"
                     style="width:100%; height:100%; object-fit:cover;" />
            </div>

            <!-- CAROUSEL ẢNH -->
            <div class="thumb-carousel relative mt-3" style="display:flex; align-items:center; gap:8px;">
                <button id="thumbPrev" class="thumb-nav">‹</button>
                <div id="thumbContainer"
                     class="thumb-track"
                     style="flex:1;overflow:hidden;display:flex;gap:8px;">

                    @if (imagesByColor.ContainsKey(defaultColor))
                    {
                        foreach (var file in imagesByColor[defaultColor])
                        {
                            var thumbSrc = GetImagePath(file);
                            <img class="thumb"
                                 src="@thumbSrc"
                                 data-src="@thumbSrc"
                                 style="width:125px;height:125px;object-fit:cover;cursor:pointer;padding:3px;" />
                        }
                    }
                </div>

                <button id="thumbNext" class="thumb-nav">›</button>
            </div>

        </div>

        <div class="product-info">
            <div class="product-header">
                <div class="product-category">@categoryName</div>
                <h1 class="product-title">@Model.NamePro</h1>
                <div class="product-price"
                     id="productPrice"
                     data-price="@(Model.Price ?? 0)">
                    @((Model.Price ?? 0).ToString("N0"))₫
                </div>
                <div class="rating">
                    @*<div class="stars">
                    <span class="star">★</span>
                    <span class="star">★</span>
                    <span class="star">★</span>
                    <span class="star">★</span>
                    <span class="star">★</span>
                </div>*@
                    @*<span>1257</span>*@
                </div>
            </div>

            <div class="color-section">
                <div class="section-label">Màu sắc</div>

                <div id="colorOptions" style="display:flex; gap:8px; flex-wrap:wrap;">
                    @foreach (var kv in imagesByColor)
                    {
                        var color = kv.Key;
                        var file = kv.Value.FirstOrDefault();
                        var thumb = GetImagePath(file);

                        // tên màu từ dictionary
                        var colorLabel = colorNames.ContainsKey(color)
                            ? colorNames[color]
                            : $"Màu {color}";

                        <div class="color-option"
                             data-color="@color"
                             data-name="@colorLabel" @* 👈 lưu luôn ColorName ở đây *@
                             style="cursor:pointer;text-align:center;">

                            <img src="@thumb"
                                 alt="@colorLabel"
                                 title="@colorLabel"
                                 style="width:75px;height:75px;object-fit:cover;padding:4px;" />

                            <div style="font-size:12px">@colorLabel</div>
                        </div>
                    }
                </div>

                @{
                    var selectedColorName = colorNames.ContainsKey(defaultColor)
                        ? colorNames[defaultColor]
                        : "Không rõ màu";
                }
                <div class="color-name" id="selectedColorName">
                    @selectedColorName
                </div>
            </div>


            <div class="size-section">
                <div class="size-header">
                    <div class="section-label">Kích cỡ</div>
                </div>
                <div class="size-grid">
                    <button class="size-option">S</button>
                    <button class="size-option">M</button>
                    <button class="size-option active">L</button>
                    <button class="size-option">XL</button>
                </div>
                <div class="stock-info">
                    <span>ℹ️</span>

                    <span id="stockText">Đang kiểm tra tồn kho...</span>
                </div>
            </div>


            <div class="action-buttons">
                <button class="btn-primary " style="height:60px;">
                    <span>🛒</span>
                    THÊM VÀO GIỎ HÀNG
                </button>
            </div>

        </div>
    </div>
    <!-- POPUP GIỎ HÀNG -->
    <div id="cartPopup" class="fixed inset-0 hidden items-center justify-center bg-black/50 z-[9999]">
        @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post, new { id = "orderForm" }))// sửa
        {
            <!-- CÁC INPUT ẨN GỬI SANG TRANG ĐẶT HÀNG -->
            <input type="hidden" name="ProductID" value="@Model.ProductID" />
            <input type="hidden" name="ImagePro" id="hfImagePro" value="@Model.ImagePro" /> <!-- fix -->
            <input type="hidden" name="Color" id="hfColor" value="" />
            <input type="hidden" name="Size" id="hfSize" value="" />
            <input type="hidden" name="Quantity" id="hfQty" value="1" />

            <div class="mx-4 bg-white w-full max-w-5xl rounded-lg shadow-2xl relative">
                <!-- tắt x -->
                <button type="button" class="absolute -right-3 -top-3 bg-white border rounded-md w-10 h-10 flex items-center justify-center text-2xl"
                        aria-label="Đóng" onclick="closeCartPopup()">
                    ✕
                </button>

                <div class="p-6">
                    <div class="grid grid-cols-12 gap-6">
                        <!-- trái -->
                        <div class="col-span-12 md:col-span-6 flex gap-6">
                            <img id="popupImage" src="" alt="Product"
                                 class="w-40 h-40 object-cover rounded-md bg-gray-100 border" />
                            <div class="min-w-0">
                                <h3 id="popupName" class="text-lg font-bold uppercase leading-tight">
                                </h3>
                                <div id="popupUnitPrice" class="font-semibold mt-1"> </div>

                                <ul class="mt-3 text-sm leading-6 space-y-1 list-none p-0 m-0">
                                    <li><span class="text-gray-500">Colour:</span> <span id="popupColor"></span></li>
                                    <li><span class="text-gray-500">Kích cỡ:</span> <span id="popupSize"></span></li>
                                    <li class="flex flex-wrap items-center gap-3 mt-3">
                                        <span class="text-gray-500 text-sm">Số lượng:</span>
                                        <div class="flex flex-col">
                                            <div class="flex items-center border rounded-md overflow-hidden">
                                                <button id="btnQtyMinus" type="button"
                                                        onclick="changeQty(-1)"
                                                        class="px-2 py-1 text-lg hover:bg-gray-200 sm:px-3 sm:py-1">
                                                    −
                                                </button>

                                                <span id="popupQty" class="px-2 min-w-[32px] text-center font-medium">1</span>

                                                <button id="btnQtyPlus" type="button"
                                                        onclick="changeQty(1)"
                                                        class="px-2 py-1 text-lg hover:bg-gray-200">
                                                    +
                                                </button>
                                            </div>

                                            <!-- chỗ hiện thông báo -->
                                            <span id="qtyWarning"
                                                  class="mt-1 text-xs text-red-500 hidden">
                                            </span>
                                        </div>
                                    </li>

                                </ul>
                            </div>
                        </div>

                        <div class="hidden md:block col-span-12 md:col-span-1">
                            <div class="w-px h-full bg-gray-200 mx-auto"></div>
                        </div>

                        <!-- bên phải -->
                        <div class="col-span-12 md:col-span-5">
                            <h4 class="font-bold mb-2">GIỎ HÀNG CỦA BẠN</h4>

                            <div class="space-y-1 text-sm">
                                <div class="flex justify-between">
                                    <span id="popupItemCount">1 mặt hàng</span><span></span>
                                </div>

                                <div id="rowOriginal" class="flex justify-between py-1 hidden">
                                    <span>Giá gốc:</span>
                                    <span id="popupOriginal" class="line-through text-gray-500">0₫</span>
                                </div>

                                <div class="flex justify-between py-1">
                                    <span>Tổng Giá Trị Sản Phẩm:</span><span id="popupSubtotal">0₫</span>
                                </div>
                                <div class="flex justify-between py-1">
                                    <span>Tổng Phí Giao Hàng:</span><span class="font-medium">Miễn phí</span>
                                </div>
                            </div>

                            <div class="border-t mt-2 pt-3 flex justify-between items-baseline">
                                <span class="font-extrabold text-base md:text-lg">Tổng cộng:</span>
                                <span id="popupGrandTotal" class="font-extrabold text-base md:text-lg">0₫</span>
                            </div>
                            <div class="text-xs text-gray-500 mt-1">(Đã bao gồm thuế)</div>

                            <!-- nút này sẽ gọi JS để set hidden rồi submit form -->
                            <button type="button" onclick="confirmAddToCart()"
                                    class="mt-3 w-full border border-gray-900 py-3 rounded-md font-semibold tracking-wide">
                                THÊM VÀO GIỎ HÀNG
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <script>
    window.imagesByColor = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        ViewBag.ImagesByColor ?? new Dictionary<int, List<string>>()
    ));

    window.defaultColor = "@(ViewBag.DefaultColor ?? 0)";

    window.colorNames = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        ViewBag.ColorNames ?? new Dictionary<int, string>()
    ));

    // 🔹 STOCK THEO MÀU + SIZE
    window.variantStocks = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
        ViewBag.VariantStocks ?? new object[0]
    ));
    </script>





    <!-- Load jQuery nếu cần (nếu bạn không dùng jQuery thì bỏ) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <!-- Load file JS riêng (defer để chạy sau khi DOM sẵn sàng) -->
    <script src="@Url.Content("~/Scripts/js/Details.js")?v=3" defer></script>


