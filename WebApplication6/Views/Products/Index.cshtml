
@model WebApplication6.ViewModels.ProductListViewModel

<!--CSS -->
<link rel="stylesheet" href="@Url.Content("~/Content/css/ProductIndex.css")" />

<!--Danh sách sản phẩm-->
<!-- lọc -->
<div class="flex justify-center mt-6 px-3">
    <form id="filterForm"
          method="get"
          action="@Url.Action("Index", "Products")"
          class="relative p-4 bg-gray-100 rounded-xl shadow-md w-full max-w-4xl"
          style="margin-top:10%;">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 items-end">


            <!-- Giới tính -->
            <div class="flex flex-col">
                <label class="font-semibold mb-1 text-sm">Giới tính</label>
                <select name="gender" id="gender" class="border rounded-lg p-2 w-full">
                    <option value="">Tất cả</option>
                    <option value="male" @(Model.Gender == "male" ? "selected" : "")>Nam</option>
                    <option value="female" @(Model.Gender == "female" ? "selected" : "")>Nữ</option>
                    <option value="unisex" @(Model.Gender == "unisex" ? "selected" : "")>Unisex</option>
                </select>
            </div>

            <!-- Loại: dùng AllCategories và gửi IDCate (số) -->
            <div class="flex flex-col">
                <label class="font-semibold mb-1 text-sm">Loại</label>
                <select name="category" id="category" class="border rounded-lg p-2 w-full">
                    <option value="">Tất cả</option>
                    @if (Model.AllCategories != null)
                    {
                        foreach (var c in Model.AllCategories)
                        {
                            // sử dụng IDCate (theo code Create dùng "IDCate")
                            <option value="@c.IDCate" @(Model.Category == c.IDCate.ToString() ? "selected" : "")>
                                @c.NameCate
                            </option>

                        }
                    }
                </select>
            </div>


            <!-- Giá: giữ lựa chọn -->
            <div class="flex flex-col">
                <label class="font-semibold mb-1 text-sm">Giá</label>
                <select name="priceSort" id="priceSort" class="border rounded-lg p-2 w-full">
                    <option value="">Không sắp xếp</option>
                    <option value="asc" @(Model.PriceSort == "asc" ? "selected" : "")>Thấp → Cao</option>
                    <option value="desc" @(Model.PriceSort == "desc" ? "selected" : "")>Cao → Thấp</option>
                </select>
            </div>

            <!-- 2 nút -->
            <div class="flex gap-3 justify-start md:justify-end items-center">
                <button type="submit"
                        id="filterBtn"
                        class="bg-black text-white px-4 py-2 rounded-2xl font-semibold hover:bg-neutral-900 transition w-full md:w-auto">
                    Lọc
                </button>

                <button type="button"
                        id="resetBtn"
                        class="bg-black text-white px-4 py-2 rounded-2xl font-semibold hover:bg-neutral-900 transition w-full md:w-auto">
                    Xóa
                </button>
            </div>
        </div>

        <!-- Note -->
        <div class="mt-3">
            <p id="resetNotice"
               style="
           max-height: 0;
           overflow: hidden;
           padding-top: 0;
           padding-bottom: 0;
           margin: 0 auto;
           transition: max-height 300ms ease, padding 300ms ease, opacity 300ms;
           opacity: 0;
           color: #dc2626;
           font-weight: 600;
           text-align:center;
         ">
                Nhấn Lọc để xác nhận xóa.
            </p>
        </div>

    </form>
</div>

<hr />

<!-- Danh sách sản phẩm -->
<div class="container" bis_skin_checked="1">
    <div class="product-grid" id="productGrid" bis_skin_checked="1">
        @if (Model.Products != null && Model.Products.Any())
        {
            foreach (var p in Model.Products)
            {
                // ---- TÍNH ĐƯỜNG DẪN ẢNH Ở ĐÂY ----
                var imgSrc = "";

                if (string.IsNullOrEmpty(p.ImagePro))
                {
                    imgSrc = Url.Content("~/Content/images/no-image.png");
                }
                else if (p.ImagePro.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                {
                    // URL ngoài (adidas, v.v.)
                    imgSrc = p.ImagePro;
                }
                else
                {
                    // file trong thư mục Content/images
                    imgSrc = Url.Content("~/Content/images/" + p.ImagePro);
                }
                // -----------------------------------

                <a class="product-card" href="@Url.Action("Details", "Products", new { id = p.ProductID })">
                    <div class="product-image">
                        <img src="@imgSrc"
                             alt="@p.NamePro"
                             style="width:100%; height:100%; object-fit:cover;" />
                    </div>
                    <div class="product-info">
                        <div style="font-weight:bold;">@p.NamePro</div>
                        <div>@String.Format("{0:N0}₫", p.Price)</div>
                    </div>
                </a>
            }
        }
        else
        {
            <div>Không có sản phẩm.</div>
        }
    </div>
</div>


<!--Java Script-->
<script src="~/Scripts/js/ProductIndex.js"></script>

