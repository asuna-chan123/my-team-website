@using PagedList.Mvc
@using WebApplication6.Models
@using WebApplication6.ViewModels
@model WebApplication6.ViewModels.ProductListViewModel

@{
    ViewBag.Title = "Adidas";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var top = ViewBag.TopBanner as WebApplication6.Models.Banner;
    var mid = ViewBag.MiddleBanner as WebApplication6.Models.Banner;
}

@functions {
    public string ResolveImage(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return Url.Content("~/Content/images/no-image.png");
        }

        if (imageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            return imageUrl;
        }

        return Url.Content("~/Content/images/" + imageUrl);
    }
}

<link rel="stylesheet" href="~/Content/css/ProductList.css" />
<link rel="stylesheet" href="~/Content/css/fonts-reset.css" />

<!-- BANNER ĐẦU TRANG -->
<section class="hero-section banner-topp" style="margin-top:10%;">
    <div class="banner-containerr banner-imgg"
         style="background-image:url('@(top?.ImageUrl ?? "")')">
        <div class="hero-content">
            <div class="content-wrapper">
                <h1 class="main-title"
                    style="font-size:35px; margin-right:40%; border:2px solid #000; background:#fff; color:#000; font-weight:bold;">
                    @(top?.Title ?? "LIGHT THE BAY")
                </h1>

                <p class="subtitle"
                   style="font-size:25px; border:2px solid #000; background:#fff; color:#000; font-weight:bold;">
                    @(top?.Subtitle ?? "Sẵn sàng tăng tốc cùng bộ sưu tập adidas x Mercedes")
                </p>

                <button class="cta-button"
                        onclick="handleClick('@(top?.ButtonLink ?? Url.Action("ProductList", "Products"))')">
                    <span>@(top?.ButtonText ?? "Mua ngay →")</span>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- CAROUSEL T-SHIRT -->
<div class="container">
    <h1 class="section-title">T-shirt</h1>

    <div class="carousel-container js-carousel tshirt-carousel">
        <button class="nav-button prev">‹</button>
        <button class="nav-button next">›</button>

        <div class="carousel-wrapper">
            @if (Model.Products != null && Model.Products.Any())
            {
                foreach (var p in Model.Products)
                {
                    <a href="@Url.Action("Details", "Products", new { id = p.ProductID })"
                       class="product-card-link">
                        <div class="card">
                            <img src="@ResolveImage(p.ImagePro)"
                                 alt="@p.NamePro"
                                 class="card-image" />
                            <div class="card-content">
                                <h3 class="card-title">@String.Format("{0:N0}₫", p.Price)</h3>
                                <p class="card-description">@p.NamePro</p>
                                <span class="card-button">MUA SẮM NGAY</span>
                            </div>
                        </div>
                    </a>
                }
            }
            else
            {
                <p>Không có sản phẩm.</p>
            }
        </div>
    </div>
</div>

<!-- BANNER GIỮA TRANG -->
<section class="hero-section banner-topp">
    <div class="banner-containerr banner-imgg"
         style="background-image:url('@(mid?.ImageUrl ?? "")')">
        <div class="hero-content">
            <div class="content-wrapper">
                <h1 class="main-title"
                    style="font-size:35px; margin-right:40%; border:2px solid #000; background:#fff; color:#000; font-weight:bold;">
                    @(mid?.Title ?? "LIGHT THE BAY")
                </h1>

                <p class="subtitle"
                   style="font-size:25px; border:2px solid #000; background:#fff; color:#000; font-weight:bold;">
                    @(mid?.Subtitle ?? "Sẵn sàng tăng tốc cùng bộ sưu tập adidas x Mercedes")
                </p>

                <button class="cta-button"
                        onclick="handleClick('@(mid?.ButtonLink ?? Url.Action("ProductList", "Products"))')">
                    <span>@(mid?.ButtonText ?? "Mua ngay →")</span>
                </button>
            </div>
        </div>
    </div>
</section>

@*carousel 1, 2 *@
@helper RenderCarousel(CarouselViewModel carousel)
{
    if (carousel == null || carousel.Items == null || !carousel.Items.Any())
    {
        return;
    }

    <section class="carousel-section">
        <div class="container">
            <h1 class="section-title">@carousel.Title</h1>

            <div class="carousel-container js-carousel">
                <button class="nav-button prev">‹</button>
                <button class="nav-button next">›</button>

                <div class="carousel-wrapper">
                    @foreach (var item in carousel.Items)
                    {
                        <a href="@item.link" class="product-card-link">
                            <div class="card">
                                <img src="@item.img"
                                     class="card-image"
                                     style="height:@(item.height ?? "380px"); object-fit:cover;" />
                                <div class="card-content">
                                    <h3 class="card-title">@item.price</h3>
                                    <p class="card-description">@item.desc</p>
                                    <span class="card-button">Mua ngay</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>
}

@* Carousel từ viewmodel *@
@RenderCarousel(Model.Carousel1)
@RenderCarousel(Model.Carousel2)

