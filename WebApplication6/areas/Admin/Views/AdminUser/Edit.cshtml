@model WebApplication6.Models.AdminUser

@{
    ViewBag.Title = "Sửa tài khoản Admin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-2xl font-bold mb-4">Sửa tài khoản Admin</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ID)

    <div class="form-horizontal">
        <div class="form-group">
            @Html.LabelFor(m => m.UserName, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.UserName)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.RoleUser, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.RoleUser, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.RoleUser)
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.PasswordUser, "Mật khẩu", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.PasswordFor(m => m.PasswordUser, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.PasswordUser)
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10 mt-3">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default ml-2" })
            </div>
        </div>
    </div>
}
