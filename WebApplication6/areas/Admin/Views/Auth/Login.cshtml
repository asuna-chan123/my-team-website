@{
    ViewBag.Title = "Đăng nhập Admin";
    Layout = "~/Areas/Admin/Views/Shared/_LoginLayout.cshtml";
}

@section Styles {
    <style>
        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #e5e7eb; /* xám nhạt giống hình */
        }

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background: #ffffff;
            border-radius: 8px;
            padding: 32px 36px 28px;
            width: 100%;
            max-width: 360px;
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
            text-align: center;
        }

        .login-avatar {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: #3b82f6; /* xanh */
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            color: #ffffff;
            font-size: 34px;
        }

        .login-title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #111827;
        }

        .field-group {
            text-align: left;
            margin-bottom: 14px;
            position: relative;
            max-width:305px;
        }

        .field-input {
            width: 100%;
            border-radius: 4px;
            border: 1px solid #d1d5db;
            padding: 10px 40px 10px 12px;
            font-size: 14px;
            outline: none;
            background-color: #f9fafb;
        }

            .field-input:focus {
                border-color: #3b82f6;
                background-color: #ffffff;
            }

        .field-icon {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 16px;
            color: #9ca3af;
        }

        .btn-login {
            width: 100%;
            border-radius: 4px;
            border: none;
            padding: 10px 0;
            margin-top: 8px;
            font-size: 14px;
            font-weight: 600;
            background: #2563eb;
            color: #ffffff;
            cursor: pointer;
        }

            .btn-login:hover {
                background: #1d4ed8;
            }

        .forgot {
            margin-top: 14px;
            font-size: 12px;
            color: #6b7280;
        }

            .forgot a {
                color: #2563eb;
                text-decoration: none;
            }

                .forgot a:hover {
                    text-decoration: underline;
                }

        .login-error {
            background: #fee2e2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            border-radius: 4px;
            padding: 6px 8px;
            font-size: 12px;
            margin-bottom: 12px;
            text-align: left;
        }
    </style>
}

<div class="login-wrapper">
    <div class="login-card">

        <div class="login-title">Admin Log in</div>

        @if (ViewBag.Error != null)
        {
            <div class="login-error">
                @ViewBag.Error
            </div>
        }

        @using (Html.BeginForm("Login", "Auth", FormMethod.Post, new { area = "Admin" }))
        {
            @Html.AntiForgeryToken()

            <div class="field-group">
                <input type="text"
                       name="username"
                       class="field-input"
                       placeholder="User ID"
                       autocomplete="off" />
            </div>

            <div class="field-group">
                <input type="password"
                       name="password"
                       class="field-input"
                       placeholder="Password" />
            </div>

            <button type="submit" class="btn-login">
                LOGIN
            </button>
        }

    </div>
</div>
