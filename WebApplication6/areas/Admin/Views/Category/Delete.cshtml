@model WebApplication6.Models.Category

@{
    ViewBag.Title = "Xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-2xl font-bold text-red-600 mb-2">Xóa danh mục</h2>
<p class="text-sm text-gray-500 mb-6">
    Bạn có chắc chắn muốn xóa (đánh dấu đã xóa) danh mục này không?
</p>

<div class="bg-white rounded-lg shadow-sm p-6 max-w-xl mb-4">
    <dl class="divide-y divide-gray-100">
        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Mã danh mục</dt>
            <dd class="w-2/3 text-sm text-gray-900">#@Model.IDCate</dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Tên danh mục</dt>
            <dd class="w-2/3 text-sm text-gray-900">@Model.NameCate</dd>
        </div>
    </dl>
</div>

@using (Html.BeginForm("Delete", "Category", FormMethod.Post, new { area = "Admin" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IDCate)

    <div class="flex gap-2">
        <input type="submit"
               value="Xác nhận xóa"
               class="bg-red-500 text-white px-4 py-2 rounded text-sm font-medium hover:bg-red-600 cursor-pointer" />
        @Html.ActionLink("Quay lại", "Index", null,
            new { @class = "px-4 py-2 rounded border border-gray-300 text-sm text-gray-700 hover:bg-gray-100" })
    </div>
}
