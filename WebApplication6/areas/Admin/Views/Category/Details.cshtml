@model WebApplication6.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-2xl font-bold text-[#042954] mb-2">Chi tiết danh mục</h2>
<p class="text-sm text-gray-500 mb-6">Thông tin chi tiết của danh mục.</p>

<div class="bg-white rounded-lg shadow-sm p-6 max-w-xl">
    <dl class="divide-y divide-gray-100">
        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Mã danh mục</dt>
            <dd class="w-2/3 text-sm text-gray-900">#@Model.IDCate</dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Tên danh mục</dt>
            <dd class="w-2/3 text-sm text-gray-900">@Model.NameCate</dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Trạng thái</dt>
            <dd class="w-2/3 text-sm text-gray-900">
                @(Model.IsDeleted ? "Đã xóa" : "Đang sử dụng")
            </dd>
        </div>
    </dl>

    <div class="mt-6 flex gap-2">
        @Html.ActionLink("Sửa", "Edit", new { id = Model.IDCate },
            new { @class = "px-4 py-2 rounded bg-blue-50 text-blue-600 text-sm hover:bg-blue-100" })
        @Html.ActionLink("Quay lại", "Index", null,
            new { @class = "px-4 py-2 rounded border border-gray-300 text-sm text-gray-700 hover:bg-gray-100" })
    </div>
</div>
