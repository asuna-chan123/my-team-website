@model WebApplication6.Models.Category

@{
    ViewBag.Title = "Sửa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-2xl font-bold text-[#042954] mb-2">Sửa danh mục</h2>
<p class="text-sm text-gray-500 mb-6">Chỉnh sửa thông tin danh mục sản phẩm.</p>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IDCate)

    @Html.ValidationSummary(false, "", new { @class = "text-red-500 mb-3" })

    <div class="bg-white rounded-lg shadow-sm p-6 max-w-lg">
        <div class="mb-4">
            @Html.LabelFor(m => m.NameCate, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
            @Html.TextBoxFor(m => m.NameCate,
                new
                {
                    @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm " +
                             "focus:outline-none focus:ring-1 focus:ring-[#FFA500] focus:border-[#FFA500]"
                })
            @Html.ValidationMessageFor(m => m.NameCate, "", new { @class = "text-red-500 text-xs" })
        </div>

        <div class="flex gap-2">
            <input type="submit"
                   value="Lưu"
                   class="bg-[#FFA500] text-white px-4 py-2 rounded text-sm font-medium hover:bg-orange-600 transition-colors cursor-pointer" />
            @Html.ActionLink("Quay lại", "Index", null,
                new { @class = "px-4 py-2 rounded border border-gray-300 text-sm text-gray-700 hover:bg-gray-100" })
        </div>
    </div>
}
