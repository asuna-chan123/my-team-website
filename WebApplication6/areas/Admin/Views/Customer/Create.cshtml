@*@model WebApplication6.Models.Customer

@{
    ViewBag.Title = "Thêm khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-2xl font-bold text-[#042954] mb-2">Thêm khách hàng</h2>
<p class="text-sm text-gray-500 mb-6">Tạo mới một khách hàng.</p>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-red-500 mb-3" })

    <div class="bg-white rounded-lg shadow-sm p-6 max-w-lg">
        <div class="mb-4">
