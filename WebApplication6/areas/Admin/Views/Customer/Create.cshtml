            @Html.TextBoxFor(m => m.NameCus,
                new { @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-[#FFA500] focus:border-[#FFA500]" })
            @Html.ValidationMessageFor(m => m.NameCus, "", new { @class = "text-red-500 text-xs" })
        </div>

        <div class="mb-4">
            @Html.LabelFor(m => m.Email, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
            @Html.TextBoxFor(m => m.Email,
                new { @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm", type = "email" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-red-500 text-xs" })
        </div>

        <div class="mb-4">
            @Html.LabelFor(m => m.Phone, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
            @Html.TextBoxFor(m => m.Phone,
                new { @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm" })
            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-red-500 text-xs" })
        </div>

        <div class="mb-6">
            @Html.LabelFor(m => m.Address, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
            @Html.TextAreaFor(m => m.Address,
                new { @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm", rows = 3 })
            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-red-500 text-xs" })
        </div>

        <div class="flex gap-2">
            <input type="submit"
                   value="Lưu"
                   class="bg-[#FFA500] text-white px-4 py-2 rounded text-sm font-medium hover:bg-orange-600 transition-colors cursor-pointer" />
            @Html.ActionLink("Quay lại", "Index", null,
                new { @class = "px-4 py-2 rounded border border-gray-300 text-sm text-gray-700 hover:bg-gray-100" })
        </div>
    </div>
