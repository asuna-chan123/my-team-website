@model WebApplication6.Models.OrderPro

@{
    ViewBag.Title = "Hủy đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-2xl font-bold text-red-600 mb-2">Hủy đơn hàng</h2>
<p class="text-sm text-gray-500 mb-6">
    Bạn có chắc chắn muốn hủy đơn hàng #@Model.ID không?
</p>

<div class="bg-white rounded-lg shadow-sm p-6 max-w-3xl mb-4">
    <p class="text-sm">
        <span class="font-semibold">Khách:</span>
        @(Model.Customer != null ? Model.Customer.NameCus : "N/A")
        @if (Model.Customer != null)
        {
            <span> (@Model.Customer.PhoneCus)</span>
        }
        <br />
        <span class="font-semibold">Ngày đặt:</span>
        @(Model.DateOrder.HasValue ? Model.DateOrder.Value.ToString("dd/MM/yyyy HH:mm") : "")
        <br />
        <span class="font-semibold">Địa chỉ:</span> @Model.AddressDeliverry
    </p>
</div>

@if (Model.OrderDetails != null && Model.OrderDetails.Any())
{
    <div class="bg-white rounded-lg shadow-sm p-4 mb-4">
        <table class="min-w-full text-sm border">
            <thead class="bg-gray-100">
                <tr>
                    <th class="border px-2 py-1">Sản phẩm</th>
                    <th class="border px-2 py-1">SL</th>
                    <th class="border px-2 py-1">Đơn giá</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.OrderDetails)
                {
                    var name = d.Product != null ? d.Product.NamePro : ("ID: " + d.IDProduct);
                    <tr class="border-t">
                        <td class="border px-2 py-1">@name</td>
                        <td class="border px-2 py-1">@d.Quantity</td>
                        <td class="border px-2 py-1">
                            @(d.UnitPrice.HasValue ? d.UnitPrice.Value.ToString("N0") + " ₫" : "-")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ID)

    <div class="mt-6 flex gap-2">
        <input type="submit"
               value="Xác nhận Hủy đơn"
               class="bg-red-500 text-white px-4 py-2 rounded text-sm font-medium hover:bg-red-600 cursor-pointer" />
        @Html.ActionLink("Quay lại", "Index", null,
            new { @class = "px-4 py-2 rounded border border-gray-300 text-sm text-gray-700 hover:bg-gray-100" })
    </div>
}
