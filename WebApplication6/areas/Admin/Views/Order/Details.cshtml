@model WebApplication6.Models.OrderPro

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    // TÍNH TOTAL 1 LẦN Ở ĐÂY
    decimal? total = Model.TotalPrice;
    if (!total.HasValue && Model.OrderDetails != null && Model.OrderDetails.Any())
    {
        total = Model.OrderDetails.Sum(d =>
            (decimal)(d.Quantity ?? 0) * (decimal)(d.UnitPrice ?? 0));
    }

    Func<int?, string> statusText = s =>
    {
        switch (s ?? 0)
        {
            case 0: return "Chờ duyệt";
            case 1: return "Đang chuẩn bị";
            case 2: return "Đang giao";
            case 3: return "Hoàn thành";
            case 4: return "Đã hủy";
            default: return "Không rõ";
        }
    };
}


<h2 class="text-2xl font-bold text-[#042954] mb-2">Chi tiết đơn hàng</h2>
<p class="text-sm text-gray-500 mb-6">Thông tin đơn hàng và các sản phẩm.</p>

<div class="bg-white rounded-lg shadow-sm p-6 max-w-3xl">
    <dl class="divide-y divide-gray-100">
        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Mã đơn</dt>
            <dd class="w-2/3 text-sm text-gray-900">#@Model.ID</dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Ngày đặt</dt>
            <dd class="w-2/3 text-sm text-gray-900">
                @(Model.DateOrder.HasValue ? Model.DateOrder.Value.ToString("dd/MM/yyyy HH:mm") : "")
            </dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Khách hàng</dt>
            <dd class="w-2/3 text-sm text-gray-900">
                @(Model.Customer != null ? Model.Customer.NameCus : "N/A")
                @if (Model.Customer != null)
                {
                    <span class="text-gray-500"> (@Model.Customer.PhoneCus)</span>
                }
            </dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Địa chỉ giao</dt>
            <dd class="w-2/3 text-sm text-gray-900">@Model.AddressDeliverry</dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Trạng thái</dt>
            <dd class="w-2/3 text-sm text-gray-900">@statusText(Model.Status)</dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Tổng tiền</dt>
            <dd class="w-2/3 text-sm text-gray-900">
                @(total.HasValue ? total.Value.ToString("N0") + " ₫" : "-")
            </dd>
        </div>
    </dl>
</div>

@if (Model.OrderDetails != null && Model.OrderDetails.Any())
{
    <h3 class="text-lg font-semibold mt-8 mb-4">Sản phẩm trong đơn</h3>

    <div class="bg-white rounded-lg shadow-sm p-4">
        <table class="min-w-full text-sm border">
            <thead class="bg-gray-100">
                <tr>
                    <th class="border px-2 py-1">Sản phẩm</th>
                    <th class="border px-2 py-1">Số lượng</th>
                    <th class="border px-2 py-1">Đơn giá</th>
                    <th class="border px-2 py-1">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.OrderDetails)
                {
                    var name = d.Product != null ? d.Product.NamePro : ("ID: " + d.IDProduct);
                    decimal lineTotal =
                        (decimal)(d.Quantity ?? 0) * (decimal)(d.UnitPrice ?? 0);


                    <tr class="border-t">
                        <td class="border px-2 py-1">@name</td>
                        <td class="border px-2 py-1">@d.Quantity</td>
                        <td class="border px-2 py-1">
                            @(d.UnitPrice.HasValue ? d.UnitPrice.Value.ToString("N0") + " ₫" : "-")
                        </td>
                        <td class="border px-2 py-1">@lineTotal.ToString("N0") ₫</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-6 flex gap-2">
    @Html.ActionLink("Sửa", "Edit", new { id = Model.ID },
        new { @class = "px-4 py-2 rounded bg-blue-50 text-blue-600 text-sm hover:bg-blue-100" })
    @Html.ActionLink("Quay lại", "Index", null,
        new { @class = "px-4 py-2 rounded border border-gray-300 text-sm text-gray-700 hover:bg-gray-100" })
</div>
