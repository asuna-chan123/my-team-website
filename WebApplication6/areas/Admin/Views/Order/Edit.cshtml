@model WebApplication6.Models.OrderPro

@{
    ViewBag.Title = "Sửa đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    Func<int?, string> statusText = s =>
    {
        switch (s ?? 0)
        {
            case 0: return "Chờ duyệt";
            case 1: return "Đang chuẩn bị";
            case 2: return "Đang giao";
            case 3: return "Hoàn thành";
            case 4: return "Đã hủy";
            default: return "Không rõ";
        }
    };
}

<h2 class="text-2xl font-bold text-[#042954] mb-2">Sửa đơn hàng</h2>
<p class="text-sm text-gray-500 mb-6">Cập nhật địa chỉ giao và trạng thái đơn hàng.</p>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ID)

    <div class="bg-white rounded-lg shadow-sm p-6 max-w-3xl">
        <div class="mb-4 text-sm text-gray-600">
            Mã đơn: <span class="font-semibold">#@Model.ID</span> ·
            Ngày đặt:
            @(Model.DateOrder.HasValue ? Model.DateOrder.Value.ToString("dd/MM/yyyy HH:mm") : "")
            <br />
            Khách hàng:
            @(Model.Customer != null ? Model.Customer.NameCus : "N/A")
            @if (Model.Customer != null)
            {
                <span>(@Model.Customer.PhoneCus)</span>
            }
        </div>

        <div class="mb-4">
            @Html.LabelFor(m => m.AddressDeliverry, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
            @Html.TextAreaFor(m => m.AddressDeliverry, 3, 0,
                new
                {
                    @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm " +
                             "focus:outline-none focus:ring-1 focus:ring-[#FFA500] focus:border-[#FFA500]"
                })
            @Html.ValidationMessageFor(m => m.AddressDeliverry, "", new { @class = "text-red-500 text-xs" })
        </div>

        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Trạng thái</label>
            @Html.DropDownListFor(m => m.Status,
                new SelectList(new[]
                {
                    new { Value = 0, Text = "Chờ duyệt" },
                    new { Value = 1, Text = "Đang chuẩn bị" },
                    new { Value = 2, Text = "Đang giao" },
                    new { Value = 3, Text = "Hoàn thành" },
                    new { Value = 4, Text = "Đã hủy" }
                }, "Value", "Text", Model.Status),
                new
                {
                    @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm " +
                             "focus:outline-none focus:ring-1 focus:ring-[#FFA500] focus:border-[#FFA500]"
                })
        </div>

        <div class="mb-4">
            @Html.LabelFor(m => m.TotalPrice, "Tổng tiền",
                new { @class = "block text-sm font-medium text-gray-700 mb-1" })

            @Html.TextBoxFor(m => m.TotalPrice,
                "{0:N0}",   // format có dấu phẩy
                new
                {
                    @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm bg-gray-100",
                    @readonly = "readonly"
                })
        </div>


        <div class="flex gap-2 mt-6">
            <input type="submit"
                   value="Lưu"
                   class="bg-[#FFA500] text-white px-4 py-2 rounded text-sm font-medium hover:bg-orange-600 transition-colors cursor-pointer" />
            @Html.ActionLink("Quay lại", "Index", null,
                new { @class = "px-4 py-2 rounded border border-gray-300 text-sm text-gray-700 hover:bg-gray-100" })
        </div>
    </div>
}
