@model WebApplication6.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-2xl font-bold text-red-600 mb-2">Xóa sản phẩm</h2>
<p class="text-sm text-gray-500 mb-6">
    Bạn có chắc chắn muốn ẩn (đánh dấu đã xóa) sản phẩm này không?
    Các biến thể vẫn được giữ trong hệ thống nhưng sẽ không hiển thị trên website.
</p>

@* Thông tin chung (dồn từ _ProductDetails.cshtml) *@
<div class="bg-white rounded-lg shadow-sm p-6 max-w-3xl">
    <dl class="divide-y divide-gray-100">
        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Mã sản phẩm</dt>
            <dd class="w-2/3 text-sm text-gray-900">#@Model.ProductID</dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Tên sản phẩm</dt>
            <dd class="w-2/3 text-sm text-gray-900">@Model.NamePro</dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Giới tính</dt>
            <dd class="w-2/3 text-sm text-gray-900">@Model.Gender</dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Danh mục</dt>
            <dd class="w-2/3 text-sm text-gray-900">
                @(Model.Category != null ? Model.Category.NameCate : "")
            </dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Mô tả</dt>
            <dd class="w-2/3 text-sm text-gray-900 whitespace-pre-line">
                @Model.DecriptionPro
            </dd>
        </div>

        <div class="py-3 flex">
            <dt class="w-1/3 text-sm font-medium text-gray-500">Trạng thái</dt>
            <dd class="w-2/3 text-sm text-gray-900">
                @(Model.IsDeleted ? "Đã ẩn" : "Đang bán")
            </dd>
        </div>
    </dl>
</div>

@if (Model.ProductVariants != null && Model.ProductVariants.Any())
{
    <h3 class="text-lg font-semibold mt-8 mb-4">Biến thể liên quan</h3>

    <div class="bg-white rounded-lg shadow-sm p-4">
        <table class="min-w-full text-sm border">
            <thead class="bg-gray-100">
                <tr>
                    <th class="border px-2 py-1">ID</th>
                    <th class="border px-2 py-1">Màu</th>
                    <th class="border px-2 py-1">Size</th>
                    <th class="border px-2 py-1">Giá</th>
                    <th class="border px-2 py-1">Tồn kho</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.ProductVariants.OrderBy(pv => pv.VariantID))
                {
                    <tr class="border-t">
                        <td class="border px-2 py-1">@v.VariantID</td>
                        <td class="border px-2 py-1">@v.ColorID</td>
                        <td class="border px-2 py-1">@v.SizeID</td>
                        <td class="border px-2 py-1">
                            @(v.Price.HasValue ? v.Price.Value.ToString("N0") + " ₫" : "-")
                        </td>
                        <td class="border px-2 py-1">@v.StockQty</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@using (Html.BeginForm("Delete", "Product", FormMethod.Post, new { area = "Admin" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ProductID)

    <div class="mt-6 flex gap-2">
        <input type="submit"
               value="Xác nhận xóa"
               class="bg-red-500 text-white px-4 py-2 rounded text-sm font-medium hover:bg-red-600 cursor-pointer" />
        @Html.ActionLink("Quay lại", "Index", null,
            new { @class = "px-4 py-2 rounded border border-gray-300 text-sm text-gray-700 hover:bg-gray-100" })
    </div>
}
