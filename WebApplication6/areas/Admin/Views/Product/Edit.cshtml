@model WebApplication6.Models.Product

@{
    ViewBag.Title = "Sửa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@{
    string imgSrc = Model.ImagePro;

    if (!string.IsNullOrEmpty(imgSrc) &&
        !imgSrc.StartsWith("http", StringComparison.OrdinalIgnoreCase))
    {
        // Trường hợp lưu chỉ là tên file -> dùng ảnh local
        imgSrc = Url.Content("~/Content/images/" + imgSrc);
    }
}
<h2 class="text-2xl font-bold text-[#042954] mb-2">Sửa sản phẩm</h2>
<p class="text-sm text-gray-500 mb-6">Chỉnh sửa thông tin sản phẩm.</p>

@using (Html.BeginForm("Edit", "Product", FormMethod.Post, new { area = "Admin" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ProductID)

    @Html.ValidationSummary(false, "", new { @class = "text-red-500 mb-3" })

    <div class="bg-white rounded-lg shadow-sm p-6 max-w-2xl">
        <!-- Tên sản phẩm -->
        <div class="mb-4">
            @Html.LabelFor(m => m.NamePro, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
            @Html.TextBoxFor(m => m.NamePro,
                new
                {
                    @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm " +
                             "focus:outline-none focus:ring-1 focus:ring-[#FFA500] focus:border-[#FFA500]"
                })
            @Html.ValidationMessageFor(m => m.NamePro, "", new { @class = "text-red-500 text-xs" })
        </div>

        <!-- Mô tả -->
        <div class="mb-4">
            @Html.LabelFor(m => m.DecriptionPro, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
            @Html.TextAreaFor(m => m.DecriptionPro,
                new
                {
                    @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm " +
                             "focus:outline-none focus:ring-1 focus:ring-[#FFA500] focus:border-[#FFA500]",
                    rows = 4
                })
            @Html.ValidationMessageFor(m => m.DecriptionPro, "", new { @class = "text-red-500 text-xs" })
        </div>

        <!-- Danh mục -->
        <div class="mb-4">
            @Html.Label("Danh mục", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
            @Html.DropDownList("CateID",
                (SelectList)ViewBag.CateID,
                "-- Chọn danh mục --",
                new
                {
                    @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm " +
                             "focus:outline-none focus:ring-1 focus:ring-[#FFA500] focus:border-[#FFA500]"
                })
            @Html.ValidationMessageFor(m => m.CateID, "", new { @class = "text-red-500 text-xs" })
        </div>

        <!-- Giá -->
        <div class="mb-4">
            @Html.LabelFor(m => m.Price, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
            @Html.TextBoxFor(m => m.Price,
                new
                {
                    @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm " +
                             "focus:outline-none focus:ring-1 focus:ring-[#FFA500] focus:border-[#FFA500]",
                    type = "number",
                    step = "1000"
                })
            @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-red-500 text-xs" })
        </div>

        <!-- Giới tính -->
        <div class="mb-4">
            @Html.LabelFor(m => m.Gender, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
            @Html.DropDownListFor(m => m.Gender,
                new SelectList(new[]
                {
                    new { Value = "Nam", Text = "Nam" },
                    new { Value = "Nữ", Text = "Nữ" },
                    new { Value = "Unisex", Text = "Unisex" }
                }, "Value", "Text", Model.Gender),
                "-- Chọn giới tính --",
                new
                {
                    @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm " +
                             "focus:outline-none focus:ring-1 focus:ring-[#FFA500] focus:border-[#FFA500]"
                })
            @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-red-500 text-xs" })
        </div>

        <!-- Link ảnh -->
        <div class="mb-6">
            @Html.LabelFor(m => m.ImagePro, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
            @Html.TextBoxFor(m => m.ImagePro,
                new
                {
                    @class = "w-full border border-gray-300 rounded px-3 py-2 text-sm " +
                             "focus:outline-none focus:ring-1 focus:ring-[#FFA500] focus:border-[#FFA500]",
                    placeholder = "Nhập URL ảnh (http...)"
                })
            @Html.ValidationMessageFor(m => m.ImagePro, "", new { @class = "text-red-500 text-xs" })
            @if (!string.IsNullOrEmpty(imgSrc))
            {
                <img src="@imgSrc"
                     alt="@Model.NamePro"
                     style="max-width:250px;border:1px solid #ccc;" />
            }
            else
            {
                <span>Không có ảnh</span>
            }
        </div>

        <div class="flex gap-2">
            <input type="submit"
                   value="Lưu"
                   class="bg-[#FFA500] text-white px-4 py-2 rounded text-sm font-medium hover:bg-orange-600 transition-colors cursor-pointer" />
            @Html.ActionLink("Quay lại", "Index", null,
                new { @class = "px-4 py-2 rounded border border-gray-300 text-sm text-gray-700 hover:bg-gray-100" })
        </div>
    </div>
}
