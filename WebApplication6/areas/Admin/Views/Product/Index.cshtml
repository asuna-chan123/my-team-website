@model IEnumerable<WebApplication6.Models.Product>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-2xl font-bold text-[#042954] mb-2">Products</h2>
<p class="text-sm text-gray-500 mb-6">Danh sách tất cả sản phẩm trong hệ thống.</p>

<div class="bg-white rounded-lg shadow-sm flex flex-col">
    <!-- Header card -->
    <div class="p-6 border-b border-gray-100 flex flex-col sm:flex-row justify-between sm:items-center gap-4">
        <h3 class="text-lg font-bold text-[#042954]">All Products</h3>

        <div class="flex flex-col sm:flex-row gap-2 sm:items-center">

            @using (Html.BeginForm("Index", "Product",
                new { area = "Admin" }, FormMethod.Get, new { @class = "flex gap-2 items-center" }))
            {
                <input type="text" name="search" value="@(ViewBag.Search ?? "")"
                       placeholder="Tìm theo tên sản phẩm…"
                       class="border border-gray-300 rounded px-3 py-1.5 text-sm" />

                <button type="submit"
                        class="bg-blue-500 text-white px-3 py-1.5 rounded text-sm">
                    Tìm kiếm
                </button>
            }

            @Html.ActionLink(
                "Quay lại",
                "Index",
                null,
                new { @class = "bg-[#A19AD3] text-white px-4 py-1.5 rounded text-sm font-medium hover:bg-purple-600 transition-colors uppercase" }
            )

            @Html.ActionLink(
                "Thêm sản phẩm",
                "Create",
                null,
                new { @class = "bg-[#FFA500] text-white px-4 py-1.5 rounded text-sm font-medium hover:bg-orange-600 transition-colors uppercase" }
            )
        </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto p-6">
        <table class="w-full text-left border-collapse">
            <thead class="bg-gray-50 text-gray-700 font-bold text-sm">
                <tr>
                    <th class="p-3 rounded-tl"><input type="checkbox" /></th>
                    <th class="p-3">ID</th>
                    <th class="p-3">Tên sản phẩm</th>
                    <th class="p-3">Danh mục</th>
                    <th class="p-3">Giá</th>
                    <th class="p-3">Giới tính</th>
                    <th class="p-3 rounded-tr text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody class="text-sm">
                @foreach (var item in Model)
                {
                    var isDeleted = item.IsDeleted;                  // <– dùng cờ IsDeleted
                    var rowClass = isDeleted ? "line-through text-gray-400" : "";

                    <tr class="hover:bg-gray-50 border-b border-gray-100 @rowClass">
                        <td class="p-3"><input type="checkbox" /></td>
                        <td class="p-3 text-blue-600 font-medium">#@item.ProductID</td>
                        <td class="p-3">@item.NamePro</td>
                        <td class="p-3">
                            @(item.Category != null ? item.Category.NameCate : "-")
                        </td>
                        <td class="p-3">
                            @(item.Price.HasValue ? item.Price.Value.ToString("N0") + " ₫" : "-")
                        </td>
                        <td class="p-3">@item.Gender</td>
                        <td class="p-3 text-right">
                            <div class="inline-flex items-center gap-2 text-xs">
                                @if (!isDeleted)
                                {
                                    @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID },
                                        new { @class = "px-2 py-1 rounded bg-blue-50 text-blue-600 hover:bg-blue-100" })

                                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID },
                                        new { @class = "px-2 py-1 rounded bg-gray-50 text-gray-700 hover:bg-gray-100" })
                                }
                                else
                                {
                                    <span class="px-2 py-1 rounded bg-gray-100 text-gray-400 cursor-not-allowed">
                                        Sửa
                                    </span>
                                    <span class="px-2 py-1 rounded bg-gray-100 text-gray-400 cursor-not-allowed">
                                        Chi tiết
                                    </span>
                                }

                                @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID },
                                    new { @class = "px-2 py-1 rounded bg-red-50 text-red-600 hover:bg-red-100" })
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="p-6 flex justify-end gap-2 border-t border-gray-100">
        <button type="button"
                onclick="document.querySelector('main').scrollTo({ top: 0, behavior: 'smooth' })"
                class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded transition-colors duration-200">
            Kéo lên đầu
        </button>
    </div>
</div>
