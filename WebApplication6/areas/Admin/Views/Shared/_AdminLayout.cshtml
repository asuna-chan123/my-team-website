@{
    Layout = null;
    var title = ViewBag.Title ?? "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@title</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>

        body {
            font-family: 'Roboto', sans-serif;
            background-color: #F0F1F3;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        main h1 {
            font-size: 2.25rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        main h2 {
            font-size: 1.875rem;
            font-weight: 600;
            margin-bottom: 0.75rem;
        }

        main h3 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        main p {
            margin-bottom: 1rem;
        }
    </style>
</head>
<body class="text-gray-700">
    <div class="flex h-screen overflow-hidden relative">
        <input type="checkbox" id="sidebar-toggle" class="peer hidden" />

        <!-- SIDEBAR -->
        <aside id="sidebar"
               class="fixed top-16 bottom-0 left-0 z-20 w-64 bg-[#042954] text-white
              transition-all duration-300 transform
              -translate-x-full peer-checked:translate-x-0
              lg:translate-x-0 lg:peer-checked:-translate-x-full
              flex flex-col h-full overflow-hidden shadow-xl lg:shadow-none">



            <!-- Navigation -->
            <nav class="flex-1 overflow-y-auto py-4 min-w-[16rem]">
                <ul class="space-y-1">
                    <li>
                        @* Dashboard *@
                        <a href="@Url.Action("Index", "Home", new { area = "Admin" })"
                           class="flex items-center px-6 py-3 hover:bg-white/10 transition-colors">
                            Trang chủ Admin
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("", "", new { area = "" })"
                           class="flex items-center px-6 py-3 hover:bg-white/10 transition-colors">
                            Trang chủ Customer
                        </a>
                    </li>

                    <li class="px-6 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">
                        Management
                    </li>

                    <li>
                        @* Sản phẩm *@
                        <a href="@Url.Action("Index", "Product", new { area = "Admin" })"
                           class="flex items-center px-6 py-3 hover:bg-white/10 transition-colors">
                            Products
                        </a>
                    </li>

                    <li>
                        @* Danh mục *@
                        <a href="@Url.Action("Index", "Category", new { area = "Admin" })"
                           class="flex items-center px-6 py-3 hover:bg-white/10 transition-colors">
                            Categories
                        </a>
                    </li>

                    <li>
                        @* Đặt hàng *@
                        <a href="@Url.Action("Index", "Order", new { area = "Admin" })"
                           class="flex items-center px-6 py-3 hover:bg-white/10 transition-colors">
                            Orders
                        </a>
                    </li>
                    <li>
                        @* Khách hàng *@
                        <a href="@Url.Action("Index", "Customer", new { area = "Admin" })"
                           class="flex items-center px-6 py-3 hover:bg-white/10 transition-colors">
                            Customers
                        </a>
                    </li>

                    <li class="px-6 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">
                        Attribute
                    </li>

                    <li>
                        @* Màu *@
                        <a href="@Url.Action("Index", "Color", new { area = "Admin" })"
                           class="flex items-center px-6 py-3 hover:bg-white/10 transition-colors">
                            Color
                        </a>
                    </li>

                    <li>
                        @* Size *@
                        <a href="@Url.Action("Index", "Size", new { area = "Admin" })"
                           class="flex items-center px-6 py-3 hover:bg-white/10 transition-colors">
                            Size
                        </a>
                    </li>

                    <li class="px-6 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider">
                        Home Page
                    </li>

                    <li>
                        @* Banner *@
                        <a href="@Url.Action("Index", "Banner", new { area = "Admin" })"
                           class="flex items-center px-6 py-3 hover:bg-white/10 transition-colors">
                            Banner
                        </a>
                    </li>

                    <li>
                        @* Carousel *@
                        <a href="@Url.Action("Index", "Carousel", new { area = "Admin" })"
                           class="flex items-center px-6 py-3 hover:bg-white/10 transition-colors">
                            Carousel
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- PHẦN MAIN (bên phải) -->
        <div class="flex-1 flex flex-col h-screen overflow-hidden transition-all duration-300 w-full lg:ml-64 peer-checked:lg:ml-0">

            <!-- TOPBAR -->
            @*<header class="fixed top-0 left-0 right-0 h-16 bg-white shadow-sm flex items-center justify-between px-8 sticky top-0 z-30">*@
            <header class="fixed top-0 left-0 right-0 h-16 bg-white shadow-sm flex items-center justify-between px-8 z-30">
                <div class="flex items-center">
                    <!-- Nút 3 gạch -->
                    <label for="sidebar-toggle"
                           class="mr-4 text-gray-500 cursor-pointer hover:text-[#FFA500] transition-colors p-2 rounded-full hover:bg-gray-100">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </label>

                    <div>
                        <div class="text-lg font-semibold text-[#042954]">@title</div>
                        <div class="text-xs text-gray-500">Quản trị hệ thống Adidas</div>
                    </div>
                </div>


            </header>

            <!-- NỘI DUNG THAY ĐỔI THEO MỖI TRANG -->
            <main class="flex-1 bg-[#F0F1F3] overflow-y-auto transition-all duration-300
              mt-16 peer-checked:ml-0 ">
                <div class="p-8">
                    @RenderBody()
                </div>
            </main>

        </div>
    </div>
</body>
</html>
